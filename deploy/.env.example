# Compte GitHub propriétaire des images (ex: votre nom d'utilisateur)
REGISTRY_OWNER=votre-username-github

# Tag de l'image à déployer (ex: latest ou sha-xxxxxxx)
IMAGE_TAG=latest

# Secrets de l'application
SESSION_SECRET=votre_cle_de_session_secrete
GITHUB_CLIENT_ID=votre_client_id_oauth
GITHUB_CLIENT_SECRET=votre_client_secret_oauth

# Mot de passe de la base PostgreSQL (choisissez-en un long et aléatoire)
POSTGRES_PASSWORD=votre_mot_de_passe_postgres

BACKEND_IMAGE=ghcr.io/raph4e/web2-echec-backend
BACKEND_TAG=latest
FRONTEND_IMAGE=ghcr.io/raph4e/web2-echec-frontend
FRONTEND_TAG=latest

